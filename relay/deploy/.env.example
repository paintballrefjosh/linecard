# Copy to .env and edit.

# The DNS name that points at this server (ports 80 and 443 open).
RELAY_DOMAIN=relay.example.com

# true: anyone with a sync phrase can start a sync group.
# false: only people you give an account (docker compose exec relay linecard-relay account add <name>).
LINECARD_RELAY_OPEN=true

# Batches of changes a sync group may hold. Beyond it, writes get a 507 (nothing is dropped).
LINECARD_RELAY_MAX_OPS=200000

# Image version to run: latest, or a release such as 0.3.2 (or 0.3 for the newest 0.3.x).
RELAY_VERSION=latest

# Storage one sync group may use (e.g. 256MiB, 1GiB; 0 = no limit). Writes beyond it get a 507.
LINECARD_RELAY_MAX_GROUP_BYTES=256MiB

# Delete sync groups with no change and no computer reporting in for this many days (0 = never).
# Groups are deleted for good: set it well above how long a computer may stay switched off.
LINECARD_RELAY_IDLE_DAYS=0
